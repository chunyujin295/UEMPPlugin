# Exception: OpenSSL prebuilt libs in 3rd/lib/ are version-controlled
!3rd/lib/openssl/**/*.a
!3rd/lib/openssl/**/*.lib
!3rd/lib/openssl/**/*.dll

# OpenSSL in-tree build artifacts (Configure + nmake produce these in source/)
